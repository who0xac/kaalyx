# Kaalyx secrets — copy to `.env` and fill in. `.env` is gitignored.
# Any value left blank simply disables the source/feature that needs it;
# Kaalyx skips it gracefully rather than crashing.
#
# When pipx-installed, place this file at:  ~/.config/kaalyx/.env
# (run `kaalyx config --path` to see the exact location on your machine).

# --- Subdomain / OSINT source API keys ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CHAOS_API_KEY=
IPINFO_TOKEN=

# --- GitHub tokens (used by github-subdomains, trufflehog, GitHub Actions audit) ---
# One token is enough. Provide MULTIPLE to rotate across them and avoid hitting a single
# token's API rate limit — Kaalyx round-robins whatever it finds. Two accepted forms
# (you can mix them; they're merged and de-duplicated):
#   a) a comma-separated list:
GITHUB_TOKENS=
#   b) numbered singles:
GITHUB_TOKEN=
GITHUB_TOKEN_2=
GITHUB_TOKEN_3=

# --- Telegram notifications ---
# Create a bot via @BotFather, then message it and get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
